class Student:
    def __init__(self, name, grade):
        self.name = name
        self.__grade = grade

    def update_grade(self, new_grade):
        if 0 <= new_grade <= 100:
            self.__grade = new_grade

    def show_grade(self):
        return self.__grade


student = Student("Sila", 85)
student.update_grade(92)

print(student.name)
print(student.show_grade())
